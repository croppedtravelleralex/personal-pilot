# Copy to data/scenarios/fixtures/proxy.local.env (gitignored via data/)
# Or set these environment variables before running the suite.

CAPABILITY_PROXY_NAME=udeal-scenario
CAPABILITY_PROXY_GROUP=udeal
CAPABILITY_PROXY_PROTOCOL=socks5
CAPABILITY_PROXY_HOST=198.51.100.10
CAPABILITY_PROXY_PORT=30000
CAPABILITY_PROXY_USERNAME=your-user
CAPABILITY_PROXY_PASSWORD=your-pass

# Optional T2/T3: profile id from browser_profiles table
# CAPABILITY_PROFILE_ID=

# Optional: skip headed T2/T3 when true
# CAPABILITY_SKIP_HEADED=0
