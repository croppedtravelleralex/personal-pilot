{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "personal-pilot",
  "version": "1.1.0",
  "identifier": "local.personal-pilot.desktop",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "devUrl": "http://127.0.0.1:5218",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "personal-pilot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "../bin/personal-pilot-core"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../build/windows/icon.ico"
      }
    }
  }
}
